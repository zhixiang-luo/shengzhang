{
  "expo": {
    "name": "声账",
    "slug": "shengzhang",
    "scheme": "shengzhang",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shengzhang.ledger",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "声账需要使用麦克风听取你的账单内容。录音仅用于本次识别，完成后立即丢弃。"
      }
    },
    "android": {
      "package": "com.shengzhang.ledger",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#FAF7F0"
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 232,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F0"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-localization",
      "expo-asset",
      "./plugins/with-cleartext-api"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "04dd154b-655a-4b0e-bd3f-f3fafd76ab3d"
      }
    },
    "owner": "xiaozhuluozhixiang"
  }
}
