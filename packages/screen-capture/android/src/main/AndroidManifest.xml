<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <activity
      android:name=".CaptureShortcutActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:label="快捷记账"
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="com.shengzhang.screencapture.CAPTURE" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
    <activity
      android:name=".ShareBillActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
      android:label="声账 · 记一笔"
      android:theme="@android:style/Theme.Material.Light.NoActionBar">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
      </intent-filter>
    </activity>
    <service
      android:name=".BillCaptureTileService"
      android:exported="true"
      android:icon="@drawable/ic_screen_capture_tile"
      android:label="@string/screen_capture_tile_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <service
      android:name=".BillCaptureAccessibilityService"
      android:exported="true"
      android:label="@string/screen_capture_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/screen_capture_accessibility_service" />
    </service>
  </application>
</manifest>
