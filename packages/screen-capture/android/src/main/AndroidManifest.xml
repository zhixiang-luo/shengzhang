<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <service
      android:name=".BillCaptureTileService"
      android:exported="true"
      android:icon="@drawable/ic_screen_capture_tile"
      android:label="@string/screen_capture_tile_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <service
      android:name=".BillCaptureAccessibilityService"
      android:exported="true"
      android:label="@string/screen_capture_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/screen_capture_accessibility_service" />
    </service>
  </application>
</manifest>
