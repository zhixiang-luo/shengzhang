# Copy to /opt/shengzhang/ops/alerts.env with mode 0600.
# Gmail requires an App Password, not the normal account password.
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=you@example.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=you@example.com
ALERT_SMTP_PASSWORD=replace-with-app-password
ALERT_SMTP_SECURITY=ssl
