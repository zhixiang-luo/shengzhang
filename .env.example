# API
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
DATABASE_URL=postgres://shengzhang:shengzhang@localhost:5432/shengzhang
JWT_SECRET=replace-with-at-least-32-random-characters

# WeChat Open Platform mobile application
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Voice provider
VOICE_PROVIDER=mock
VOICE_DAILY_LIMIT=20

# SiliconFlow ASR (openai-compatible /v1/audio/transcriptions)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# DeepSeek structured extraction
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional cloud provider keys reserved for later adapters
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Mobile build-time configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
