# API
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
DATABASE_URL=postgres://shengzhang:shengzhang@localhost:5432/shengzhang
JWT_SECRET=replace-with-at-least-32-random-characters

# WeChat Open Platform mobile application
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Voice provider
VOICE_PROVIDER=mock
VOICE_DAILY_LIMIT=20
VOICE_PARTIAL_DAILY_LIMIT=300
VOICE_IP_MINUTE_LIMIT=30
VOICE_IP_DAILY_LIMIT=600
VOICE_GLOBAL_MINUTE_LIMIT=120
VOICE_GLOBAL_DAILY_LIMIT=5000
VOICE_MAX_STREAM_BYTES=960000
VOICE_MAX_STREAM_MS=32000
VOICE_MAX_CONCURRENT_PER_IP=8
VOICE_MAX_CONCURRENT_GLOBAL=80

# Privacy-first product analytics
ANALYTICS_ENABLED=true
ANALYTICS_DATA_DIR=.analytics
ANALYTICS_HASH_SALT=replace-with-at-least-32-random-characters

# SiliconFlow ASR (openai-compatible /v1/audio/transcriptions)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=Qwen/Qwen3-ASR-1.7B

# Streaming ASR: siliconflow | volcano
ASR_PROVIDER=siliconflow
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# DeepSeek structured extraction
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional cloud provider keys reserved for later adapters
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# Mobile build-time configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
